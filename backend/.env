# ==============================================================================
# AEGIS UNIFIED DATA CORE - PRODUCTION ENVIRONMENT CONFIGURATION
# ==============================================================================

# Core System
ENVIRONMENT=development
DEBUG=false
PROJECT_NAME="AEGIS UNIFIED DATA CORE"
VERSION="1.0.0"
HOST="0.0.0.0"
PORT=8000

# Security & Secret Encryption (AES-256 Fernet)
AEGIS_SECRET_KEY="MDEyMzQ1Njc4OTAxMjM0NTY3ODkwMTIzNDU2Nzg5MDE="
ENCRYPTION_KEY="MDEyMzQ1Njc4OTAxMjM0NTY3ODkwMTIzNDU2Nzg5MDE="

# JWT Authentication
JWT_SECRET="aegis_jwt_super_secret_signing_key_production_2026"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Default Admin Credentials
DEFAULT_ADMIN_EMAIL="admin@aegis.gov.in"
DEFAULT_ADMIN_PASSWORD="AegisAdmin@2026!"

# Application Client Keys
AEGIS_WEB_CLIENT_KEY="aegis_web_client_secure_key_2026"
AEGIS_APP_CLIENT_KEY="aegis_app_client_secure_key_2026"

# Database Configuration (PostgreSQL 16 + PostGIS in Docker)
POSTGRES_DB=aegis_db
POSTGRES_USER=aegis_user
POSTGRES_PASSWORD=aegis_secure_password_2026
DATABASE_URL=sqlite+aiosqlite:///./aegis_local.db
DATABASE_SYNC_URL=sqlite:///./aegis_local.db
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10

# Redis Cache & Broker in Docker
REDIS_URL=redis://redis:6379/0
CACHE_DEFAULT_TTL_SEC=300

# Security & SSRF Protection
SSRF_PROTECTION_ENABLED=true
HTTP_TIMEOUT_SECONDS=15.0
HTTP_MAX_RETRIES=3
RATE_LIMIT_PER_MINUTE=120

# Background Job Scheduler
ENABLE_BACKGROUND_SCHEDULER=true
DEFAULT_INGESTION_INTERVAL_MINUTES=5

# External Provider Configurations (Encrypted at rest once ingested)
OPEN_METEO_API_KEY=""
NASA_FIRMS_MAP_KEY=""
IMD_API_KEY=""
CWC_API_KEY=""
CPCB_API_KEY=""
MAPS_ROUTING_KEY=""
GEMINI_API_KEY=""

# CORS Whitelist (Web + Mobile App Origins)
BACKEND_CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","http://127.0.0.1:5173","http://localhost:8000","http://localhost:80","http://localhost","capacitor://localhost","ionic://localhost"]
