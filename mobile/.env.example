# Server Port
PORT=3000

# Client API Base URL
# For local physical mobile device testing, replace localhost with your LAN IP (e.g., http://192.168.1.50:3000)
# For production, set to your live HTTPS backend URL (e.g., https://api.aegisalert.com)
EXPO_PUBLIC_API_BASE_URL=http://localhost:3000

# JWT Authentication Secret (Generate a strong 32+ character random string for production)
JWT_SECRET=replace_with_a_secure_random_jwt_secret_32_chars_min

# App ID
EXPO_PUBLIC_APP_ID=aegis_alert_app

# Database Connection URL (MySQL / TiDB / PlanetScale)
DATABASE_URL=mysql://dbuser:dbpassword@host:4000/dbname?ssl={"rejectUnauthorized":true}

# Optional Mapbox Access Token (for standalone native maps)
EXPO_PUBLIC_MAPBOX_ACCESS_TOKEN=

# Allowed CORS Origins for production (comma-separated, optional)
ALLOWED_ORIGINS=https://aegisalert.com,https://app.aegisalert.com
