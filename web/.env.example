# AGIES ALERT - Environment Variables Configuration
# Copy this file to .env and configure your secret credentials

# Server & Network Configuration
PORT=5173
NODE_ENV=development
API_BASE_URL=http://localhost:5173/api

# Database
DATABASE_URL=postgresql://agies_user:agies_password@localhost:5432/agies_alert_db

# Artificial Intelligence Engine (Gemini / Anthropic / OpenAI)
AI_API_KEY=your_ai_api_key_placeholder
AI_MODEL=gemini-1.5-flash
VITE_USE_EXTERNAL_AI=false
VITE_AI_API_ENDPOINT=/api/ai/chat

# Weather & Meteorological Telemetry Providers
WEATHER_API_KEY=your_weather_api_key_placeholder
IMD_TELEMETRY_ENDPOINT=https://mausam.imd.gov.in/api/v1/telemetry
OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1

# Geospatial & Mapping Providers
MAP_API_KEY=your_map_api_key_placeholder
GEOCODING_API_KEY=your_geocoding_api_key_placeholder
TILE_SERVER_URL=https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png

# Object Storage for Incident Photos & Videos (S3 / Cloud Storage)
STORAGE_BUCKET=agies-incident-media-storage
STORAGE_ACCESS_KEY=your_storage_access_key_placeholder
STORAGE_SECRET_KEY=your_storage_secret_key_placeholder
STORAGE_REGION=ap-south-1

# Authentication & Security
JWT_SECRET=agies_super_secret_jwt_signing_key_2026
JWT_EXPIRY=7d
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_WINDOW_MS=60000

# Emergency Broadcasting & CAP (Common Alerting Protocol) Gateway
CAP_GATEWAY_URL=https://cap.ndma.gov.in/v1/broadcast
SMS_GATEWAY_KEY=your_sms_gateway_key_placeholder
